---
import "@/styles/global.css";
import { SITE_METADATA } from "@/consts";
import { ClientRouter } from "astro:transitions";
import "@fontsource/onest";
import { SEO } from "astro-seo";
import { getEntry, type CollectionEntry } from "astro:content";
import Favicon from "@/assets/avatar.jpg";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Analytics from "./Analytics.astro";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    robots?: string; // default to SITE_METADATA.robots
    titleTemplate?: string;
    /** Open Graph image when there is no blog `article.cover` (e.g. labs). */
    ogCover?: ImageMetadata;
    article?: {
        publishedTime: Date;
        modifiedTime?: Date;
        authors: string[];
        authorTwitter?: string;
        tags: string[];
        cover: CollectionEntry<"blog">["data"]["cover"];
    };
    /** Labs and other dated pages without blog `article` shape. */
    publishedDocument?: {
        publishedTime: Date;
        modifiedTime?: Date;
        authors?: string[];
    };
    /** Full canonical URL; overrides default from path + `site` (e.g. blog `canonicalUrl` frontmatter). */
    canonical?: string;
}

const {
    title,
    description,
    robots = SITE_METADATA.robots,
    article,
    ogCover,
    publishedDocument,
    titleTemplate,
    canonical: canonicalOverride,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonicalForSeo = canonicalOverride
    ? new URL(canonicalOverride, baseUrl).href
    : undefined;
const openGraphPageUrl = canonicalForSeo
    ? new URL(canonicalForSeo)
    : Astro.url;

const openGraphArticle =
    article != null
        ? {
              publishedTime: article.publishedTime.toISOString(),
              modifiedTime: article.modifiedTime?.toISOString(),
              authors: article.authors,
              tags: article.tags,
          }
        : publishedDocument != null
          ? {
                publishedTime: publishedDocument.publishedTime.toISOString(),
                modifiedTime: publishedDocument.modifiedTime?.toISOString(),
                authors: publishedDocument.authors ?? [],
                tags: [],
            }
          : null;

// The default author is the site creator
const creator = await getEntry("authors", "default");

// Optimize favicon and touch icons
const favicon = await getImage({ src: Favicon, width: 16, height: 16 });
const appleTouchIcon = await getImage({ src: Favicon, width: 76, height: 76 });
const favicon32 = await getImage({ src: Favicon, width: 32, height: 32 });
const favicon16 = await getImage({ src: Favicon, width: 16, height: 16 });

// Optimize open graph image
let openGraphImage;
if (article?.cover) {
    openGraphImage = await getImage({
        src: article.cover,
        width: 1200,
        height: 630,
    });
} else if (ogCover) {
    openGraphImage = await getImage({
        src: ogCover,
        width: 1200,
        height: 630,
    });
} else {
    const importedOgImage = await import(`../assets/avatar.jpg`).then(
        (m) => m.default,
    );
    openGraphImage = await getImage({
        src: importedOgImage,
        width: 1200,
        height: 630,
    });
}

const ogImageAbsoluteUrl = openGraphImage.src.startsWith("http")
    ? openGraphImage.src
    : new URL(openGraphImage.src, Astro.site).href;

const twitterCreator = article?.authorTwitter || creator?.data?.twitter;
const isProduction = import.meta.env.PROD;

const articleDateMeta = openGraphArticle
    ? [
          {
              property: "article:published_time",
              content: openGraphArticle.publishedTime,
          },
          ...(openGraphArticle.modifiedTime
              ? [
                    {
                        property: "article:modified_time",
                        content: openGraphArticle.modifiedTime,
                    },
                ]
              : []),
      ]
    : [];
---

<head>
    <SEO
        title={title}
        {titleTemplate}
        titleDefault={SITE_METADATA.title}
        description={description}
        nofollow={robots.includes("nofollow")}
        noindex={robots.includes("noindex")}
        canonical={canonicalForSeo}
        charset="utf-8"
        extend={{
            meta: [
                {
                    name: "theme-color",
                    content: "#fff",
                    media: "(prefers-color-scheme: light)",
                },
                {
                    name: "theme-color",
                    content: "#000",
                    media: "(prefers-color-scheme: dark)",
                },
                {
                    name: "viewport",
                    content: "width=device-width,initial-scale=1",
                },
                ...articleDateMeta,
            ],
            link: [
                { rel: "icon", type: `image/jpeg`, href: favicon.src },
                {
                    rel: "apple-touch-icon",
                    sizes: "76x76",
                    href: appleTouchIcon.src,
                },
                {
                    rel: "icon",
                    type: "image/png",
                    sizes: "32x32",
                    href: favicon32.src,
                },
                {
                    rel: "icon",
                    type: "image/png",
                    sizes: "16x16",
                    href: favicon16.src,
                },
                { rel: "mask-icon", href: favicon16.src, color: "black" },
                {
                    rel: "alternate",
                    type: "application/rss+xml",
                    href: "/rss.xml",
                },
            ],
        }}
        twitter={{
            card: "summary_large_image",
            title,
            description,
            image: ogImageAbsoluteUrl,
            ...(twitterCreator && {
                creator: twitterCreator.replace("https://twitter.com/", "@"),
            }),
        }}
        openGraph={{
            basic: {
                type: openGraphArticle ? "article" : "website",
                url: openGraphPageUrl,
                title,
                image: ogImageAbsoluteUrl,
            },
            image: {
                url: ogImageAbsoluteUrl,
                type: `image/${openGraphImage.options.format}`,
                width: openGraphImage.options.width,
                height: openGraphImage.options.height,
                alt: title,
            },
            optional: {
                locale: SITE_METADATA.language,
                description,
            },
            ...(openGraphArticle && { article: openGraphArticle }),
        }}
    />
    {isProduction && <Analytics />}
    <meta name="msvalidate.01" content="6982C2119FAEEBF0360AD66CCA79B7D8" />
    <ClientRouter />
</head>
