---
import { NAVIGATION } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import MobileNav from "@/solid/MobileNav.tsx";
import ThemeSwitcher from "@/solid/ThemeSwitcher.tsx";
import SearchButton from "@/solid/SearchButton.tsx";
import { useTranslations } from "@/i18n";
import Rss from "@/components/social-icons/icons/Rss.astro";

const t = useTranslations();
---

<header class="flex items-center justify-between py-10">
  <div class="mr-3 w-10">
    <a href="/" aria-label={t("siteMetadata.headerTitle")}>
      <Logo class="w-full rounded-4xl" />
    </a>
  </div>
  <div class="flex items-center leading-5 space-x-4 sm:space-x-6">
    {
      NAVIGATION.filter((link) => link.href !== "/").map((link) => (
        <HeaderLink
          href={link.href}
          class="hidden sm:block font-medium text-gray-900 dark:text-gray-100"
        >
          {t(link.title)}
        </HeaderLink>
      ))
    }
    <div class="flex items-center gap-4">
      <SearchButton client:only="solid-js" />
      <ThemeSwitcher client:only="solid-js" />
      <a
        href="/rss.xml"
        class="text-gray-900 transition hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400"
        aria-label={t("nav.rssFeed")}
        title={t("nav.rssFeed")}
      >
        <Rss class="h-6 w-6" />
      </a>
      <MobileNav client:only="solid-js" />
    </div>
  </div>
</header>
