---
import Link from "@/components/Link.astro";
import { SITE_METADATA } from "@/consts";
import { useTranslations } from "@/i18n";

interface Props {
  class?: string;
}

const t = useTranslations();
const url = SITE_METADATA.buyMeACoffeeUrl?.trim();
---

{
  url ? (
    <div
      class:list={[
        "not-prose border-t border-gray-200 pt-8 dark:border-gray-700",
        Astro.props.class,
      ]}
    >
      <p class="text-sm text-gray-600 dark:text-gray-400">
        <Link
          href={url}
          class="inline-flex items-center gap-2 font-medium text-primary-500 no-underline hover:text-primary-600 hover:underline dark:hover:text-primary-400"
        >
          <span>{t("components.buyMeACoffee.label")}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 shrink-0 opacity-90"
            aria-hidden="true"
          >
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <path d="M6 2v2" />
            <path d="M10 2v2" />
            <path d="M14 2v2" />
          </svg>
        </Link>
      </p>
    </div>
  ) : null
}
